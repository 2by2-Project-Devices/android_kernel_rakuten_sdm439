&cam_sensor_front_default {
	mux {
		pins = "gpio38", "gpio39", "gpio40", "gpio46";
		function = "gpio";
	};

	config {
		pins = "gpio38", "gpio39", "gpio40", "gpio46";
		drive-strength = <2>;
		bias-disable;
		output-low;
	};
};

