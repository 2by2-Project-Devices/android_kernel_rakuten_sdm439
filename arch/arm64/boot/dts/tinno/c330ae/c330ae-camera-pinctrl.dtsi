&cam_sensor_mclk0_default {
	mux {
		pins = "gpio26";
		function = "cam_mclk";
	};

	config {
		pins = "gpio26";
		drive-strength = <2>;
		bias-disable;
	};
};

&cam_sensor_mclk0_sleep {
	mux {
		pins = "gpio26";
		function = "gpio";
	};

	config {
		pins = "gpio26";
		drive-strength = <2>;
		bias-disable;
	};
};

&cam_sensor_rear_standby {
	mux {
		pins = "gpio132";
		function = "gpio";
	};

	config {
		pins = "gpio132";
		drive-strength = <2>;
		bias-disable;
		output-low;
	};
};

&cam_sensor_rear_standby_sleep {
	mux {
		pins = "gpio132";
		function = "gpio";
	};

	config {
		pins = "gpio132";
		drive-strength = <2>;
		bias-disable;
		output-low;
	};
};

